# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MINIMAX_API_KEY: Required on server side for MiniMax AI Layout text-generation calls.
# Reference: https://platform.minimax.io/docs/guides/text-generation
MINIMAX_API_KEY=""

# MINIMAX_MODEL: Optional default MiniMax text generation model (default: MiniMax-M3.1-Flash).
MINIMAX_MODEL="MiniMax-M3.1-Flash"

# MINIMAX_BASE_URL: Optional MiniMax OpenAI-compatible base URL (https://api.minimax.io/v1 or https://api.minimaxi.com/v1).
MINIMAX_BASE_URL="https://api.minimax.io/v1"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BUILD_TARGET: Optional Next.js build output target.
# Leave unset (default) for standalone server output; set to "github-pages" for static export (out/).
BUILD_TARGET=""

# GITHUB_PAGES_BASE_PATH: Subpath used when BUILD_TARGET="github-pages" (default: /SeataSagaDesigner).
GITHUB_PAGES_BASE_PATH="/SeataSagaDesigner"
